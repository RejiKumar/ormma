{
  "name": "ormma-functions",
  "private": true,
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "jest",
    "test:fns:run": "jest -c jest.fns.config.js --runInBand",
    "test:rules:run": "jest -c jest.rules.config.js --runInBand",
    "eval:reply": "npm run build && node scripts/eval-reply-structuring.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "firebase": "^13.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9"
  }
}
